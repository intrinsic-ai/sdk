# Naive workaround to work around system_python dependency in Protobuf 33 and later.
# Reqired for targets depending in pybind11_protobuf, but should help with
# hermeticity overall.
# Patch from https://github.com/protocolbuffers/protobuf/issues/24084#issuecomment-5619303017.
# References:
# * b/388805879
# * https://github.com/protocolbuffers/protobuf/issues/24084
single_version_override(
    module_name = "protobuf",
    patch_cmds = [
        "sed -i 's|@system_python//:python_headers|@rules_python//python/cc:current_py_cc_headers|g' python/build_targets.bzl python/py_extension.bzl",
