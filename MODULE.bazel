    path = "github.com/cncf/xds/go",
)

# The googlecloudrobotics is causing a build issues in latest update
go_deps_dev.gazelle_override(
    # Force Gazelle to ignore existing BUILD files and generate its own
    build_file_generation = "on",
    directives = [
        # Explicitly set the prefix so Gazelle maps labels to //src/go/pkg/...
        "gazelle:prefix github.com/googlecloudrobotics/core",
    ],
    # Use the exact module path from go.mod
    path = "github.com/googlecloudrobotics/core",
)

# kythe.io ships Bazel BUILD files for its own workspace and checked-in .pb.go files:
# generate BUILD.bazel files (which take precedence) from the Go sources instead.
go_deps_dev.gazelle_override(
    build_file_generation = "on",
    directives = [
        "gazelle:build_file_name BUILD.bazel",
        "gazelle:proto disable",
    ],
    path = "kythe.io",
)

