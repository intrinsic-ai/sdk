# Marking as dev_dependency ensures gazelle_override tags are evaluated when this repository
# is the root module (or standalone exported ioc), but ignored when consumed downstream.
go_deps_dev = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps_dev.gazelle_override(
    path = "github.com/grpc-ecosystem/grpc-gateway",
)
